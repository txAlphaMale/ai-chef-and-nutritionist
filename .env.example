# Copy this file to .env and fill in real values. .env is gitignored.

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_VISION_MODEL=llava:13b

# Tavily web search
TAVILY_API_KEY=

# App defaults
HOUSEHOLD_SIZE=2
BACKEND_PORT=8095
FRONTEND_PORT=5173

# Database (path inside the backend container; mapped to ./data via volume)
DATABASE_URL=sqlite:////app/data/chef.db
