# Copy this file to .env and fill in real values. .env is gitignored.
#
# Chef stores user-editable settings (Ollama config, Tavily key, household
# size, dietary preferences, etc.) in the database, not in this file, so
# they can be changed later from the Settings UI without a container
# rebuild. This file is only for:
#   1. Infra bootstrap values needed before the DB is reachable.
#   2. OPTIONAL first-run convenience values -- if set here, they seed the
#      matching DB setting the first time the app starts on a fresh
#      database, then this file is never read again for that value. After
#      first boot, edit these from the Settings UI instead of here.

# --- Infra bootstrap (always used) ---
# Host-side ports Docker maps to the container. Chef is ONE service that
# serves both its API and its web UI, so there is one pair, not two.
# Change either if it conflicts with something already on your machine,
# then `docker compose up` again (no --build needed).
#
# Plain HTTP. Serves the app when no certificate is installed, and
# 307-redirects to APP_HTTPS_PORT once one is.
APP_PORT=5173
# Only actually listening once you generate or import a certificate under
# Settings > Security > Certificate. Worth doing: the barcode scanner
# (camera) and Dining Out (geolocation) are gated behind a browser Secure
# Context and do not work at all over plain HTTP. See the in-app WIKI's
# "HTTPS / secure context" entry.
APP_HTTPS_PORT=5174

# Optional. Extra browser origins allowed to make credentialed API calls
# (audit P2-2). Empty is correct for a normal setup -- the browser only
# ever talks to this one origin, so every request is already same-origin
# and needs no CORS grant. Add an entry only if a page served from a
# DIFFERENT origin needs to call this API, e.g. after adding a local DNS
# name like http://chef.lan:5173. Editable from Settings; takes effect on
# restart. Scripts and curl are unaffected either way -- CORS is enforced
# by browsers, not by the API.
# CORS_ALLOW_ORIGINS=

# Path inside the backend container; mapped to ./data via the chef-data volume.
DATABASE_URL=sqlite:////app/data/chef.db

# --- Optional first-run seed values (DB is source of truth after that) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Context window (tokens) sent on every Ollama call. Ollama's own default
# is 2048 if unset -- and it silently CLIPS any prompt past that with no
# error at all, which is exactly what caused a receipt-import PDF to
# return zero items on 2026-08-02 once the import prompt grew longer.
# 8192 comfortably fits a full receipt/recipe plus instructions.
OLLAMA_NUM_CTX=8192
TAVILY_API_KEY=
# Free key from https://api.data.gov/signup/ -- lets recipe ingredients
# resolve against USDA's real food-composition database instead of relying
# solely on AI-estimated nutrition. Optional: falls back to Open Food Facts
# (no key needed), then to AI-estimated nutrition, if left blank.
USDA_FDC_API_KEY=
# Backlog B13.1 -- batch recipe import from a mounted folder (e.g. a
# OneDrive/Dropbox/Google Drive folder that already syncs to this host as
# a normal directory). Leave blank unless you've also added a matching
# bind-mount line under the `backend` service in docker-compose.yml --
# see that file's commented example and the in-app WIKI's "Recipe folder
# import" entry for the exact steps. This is a path INSIDE the container,
# not the host path itself.
RECIPE_IMPORT_FOLDER_PATH=

# --- Advanced: encryption key file locations (defaults are almost always
# fine -- both live on the same chef-data volume as the database). Losing
# secrets.key makes every encrypted setting (e.g. the Tavily key)
# permanently unrecoverable, so back it up along with the rest of ./data. ---
# SECRETS_KEY_FILE=/app/data/secrets.key
# SECRETS_KEYRING_FILE=/app/data/secrets_keyring.json
