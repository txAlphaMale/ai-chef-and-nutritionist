# Env / secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
frontend/dist*/
frontend/vite.config.js.timestamp-*.mjs

# Stray FUSE-mount build/lock leftovers, renamed here rather than deleted
# (see the local project plan's FUSE operational note)
.trash/
backend/tests/test_prompt_len_tmp.py

# Author working notes. The repo carries only what is needed to set up and
# run the app; these are local development and session-recovery records
# and are not useful to anyone cloning this.
PROJECT-PLAN.md
AUDIT-*.md

# Local-only Compose overrides (dev corpus bind mounts, host paths).
# Compose merges this automatically; it must never ship to a clone.
docker-compose.override.yml

# Data (persisted via volume, not committed)
data/*
!data/.gitkeep
!data/uploads
data/uploads/*
!data/uploads/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Personal bookmark exports dropped in here for an import run. This repo
# is PUBLIC -- a browser export is a record of what somebody reads, not
# just a list of recipes, and it does not belong in it.
Recipe_Exports*.html
*bookmarks*.html
